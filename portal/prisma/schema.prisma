generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id             String        @id
  name           String
  town           String
  region         String
  lat            Float
  lon            Float
  totalRooms     Int
  publicRateEur  Int
  lowestPriceEur Int
  maxDiscountPct Int
  blackoutDates  String[]
  createdAt      DateTime      @default(now())
  actions        OfferAction[]
}

model OfferAction {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  action          String
  guestCity       String
  checkIn         String
  nights          Int
  roomsToOffer    Int
  publicPriceEur  Int
  privatePriceEur Int
  discountPct     Float
  reasons         String[]
  editedFields    Json?
  targetSegment   String?
  segmentScore    Float?
  packageType     String?
  inclusions      String[]
  holdback        Boolean  @default(false)
  createdAt       DateTime @default(now())
}
